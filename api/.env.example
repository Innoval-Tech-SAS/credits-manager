# Laravel
APP_NAME="Credits Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.creditos.local
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=creditos_db
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Auth (Sanctum SPA)
SESSION_DOMAIN=.creditos.local
SANCTUM_STATEFUL_DOMAINS=app.creditos.local

MAIL_MAILER=log
