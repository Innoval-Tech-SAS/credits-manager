# Laravel
APP_NAME="credits-manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ddasolucionescredicias.tech

# Frontend (build del SPA servido por nginx)
VITE_API_URL=https://api.ddasolucionescredicias.tech
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# MySQL
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Auth (Sanctum SPA)
SESSION_DOMAIN=.ddasolucionescredicias.tech
SANCTUM_STATEFUL_DOMAINS=app.ddasolucionescredicias.tech

# Seed admin user (see database/seeders/UsuarioSeeder.php)
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=

# Redis (bitácora de auditoría por Streams y cola de exportaciones)
REDIS_HOST=redis
REDIS_PORT=6379

# WebSocket (Laravel Reverb): notificaciones en tiempo real
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=app.ddasolucionescredicias.tech
VITE_REVERB_HOST=api.ddasolucionescredicias.tech
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
