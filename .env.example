# Laravel
APP_NAME="credits-manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.creditos.local
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

# MySQL
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Auth (Sanctum SPA)
SESSION_DOMAIN=.creditos.local
SANCTUM_STATEFUL_DOMAINS=app.creditos.local

# Seed admin user (see database/seeders/UsuarioSeeder.php)
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_PASSWORD=

# Redis (bitácora de auditoría por Streams y cola de exportaciones)
REDIS_HOST=redis
REDIS_PORT=6379

# WebSocket (Laravel Reverb): notificaciones en tiempo real
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=app.creditos.local
VITE_REVERB_HOST=api.creditos.local
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
